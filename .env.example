# Application Runtime
PORT=3000
NODE_ENV=development

# Database Connection (PostgreSQL / Supabase / PGlite lokal)
DATABASE_URL=pglite://./.local-db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hipmi_db

# Storage Adapter (local | s3)
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./uploads
LOCAL_STORAGE_BASE_URL=http://localhost:3000/uploads
# S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
# S3_REGION=ap-southeast-1
# S3_BUCKET=hipmi-media
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=

# Test Database Connection (Optional override; defaults to in-memory PGlite WASM if omitted)
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hipmi_test_db

# JWT & Authentication
JWT_SECRET=hipmi_pt_telkom_jwt_secret_key_change_in_production_min_32_chars!
JWT_EXPIRES_IN=7d

# External Web Profile & ERP Frontend
ERP_FRONTEND_URL=http://localhost:3002
PUBLIC_WEB_URL=http://localhost:3001
REVALIDATE_SECRET=hipmi-revalidate-webhook-secret-token
